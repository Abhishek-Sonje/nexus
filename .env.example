DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
POSTGRES_PASSWORD=nexus-local-only
NEXUS_ACCESS_PASSWORD_HASH=
# Local alternative: path to a raw Argon2id PHC string (avoids dotenv $ expansion)
NEXUS_ACCESS_PASSWORD_HASH_FILE=
NEXUS_SESSION_SECRET=
NEXUS_ATTRIBUTE_HASH_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_NARRATIVE_TIMEOUT_MS=60000
GEMINI_NARRATIVE_MAX_RETRIES=1
OTEL_EXPORTER_OTLP_ENDPOINT=
NEXUS_CODE_VERSION=development
