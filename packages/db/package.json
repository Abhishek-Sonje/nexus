{
  "name": "@nexus/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "typecheck": "bun ../../node_modules/typescript/bin/tsc --noEmit",
    "db:generate": "bun node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "bun ../../node_modules/tsx/dist/cli.mjs src/migrate.ts"
  },
  "dependencies": {
    "@nexus/core": "workspace:*",
    "@nexus/detection": "workspace:*",
    "@nexus/synthetic": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
