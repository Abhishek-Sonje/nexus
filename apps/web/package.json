{
  "name": "@nexus/web",
  "private": true,
  "scripts": {
    "dev": "bun --shell=system run dev:node",
    "dev:node": "node node_modules/next/dist/bin/next dev",
    "build": "bun --shell=system run build:node",
    "build:node": "node node_modules/next/dist/bin/next build",
    "start": "bun --shell=system run start:node",
    "start:node": "node node_modules/next/dist/bin/next start",
    "typecheck": "bun ../../node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nexus/core": "workspace:*",
    "@nexus/db": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "argon2": "^0.45.1",
    "graphology": "^0.26.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.38.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sigma": "^3.0.3",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5"
  }
}
